# Neon Postgres connection string (pooled or direct). Required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=30d

# Server
PORT=8080
NODE_ENV=development

# Comma-separated allowed CORS origins (mobile dev: use * or your tunnel URL)
ALLOWED_ORIGINS=*

# Seed super admin (used by db:seed)
SEED_SUPERADMIN_PHONE=01000000000
SEED_SUPERADMIN_PASSWORD=ChangeMe@123
SEED_SUPERADMIN_FIRST=Super
SEED_SUPERADMIN_LAST=Admin
