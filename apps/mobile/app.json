{
  "expo": {
    "name": "Church QR Attendance",
    "slug": "church-qr-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "churchqr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/اجتماع العائلة المقدسة copy3.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "church.vmsb.attendance",
      "icon": "./assets/اجتماع العائلة المقدسة copy3.png",
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to scan member QR codes for attendance check-in.",
        "NSPhotoLibraryUsageDescription": "We access your photos so you can set a profile picture."
      }
    },
    "android": {
      "package": "church.vmsb.attendance",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/اجتماع العائلة المقدسة copy3.png",
        "backgroundColor": "#6B0F1A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Church QR to access your camera to scan attendance codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Church QR to access your photos to set a profile picture."
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://churchapi-production-b36b.up.railway.app",
      "eas": {
        "projectId": "916cbf47-2729-4180-8571-3271f9546966"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "elenor1010"
  }
}
